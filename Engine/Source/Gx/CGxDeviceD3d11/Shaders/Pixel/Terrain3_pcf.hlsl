    r2.xyz = (r0.wwww * v1.xyzw).xyz;
    r1.xzw = (r1.xxxx * r2.xyyz).xzw;
    r0.xyz = (r0.xyzw * r1.yyyy + r1.xzww).xyz;
    r0.xyz = (r0.xyzw + -c[2].xyzw).xyz;
    oC0.xyz = (v8.xxxx * r0.xyzw + c[2].xyzw).xyz;
    oC0.w = (d0.xxxx).w;
    AlphaTest(oC0.w);
    return oC0;
}
